# Public address people use to reach the app, exactly as in the browser's address bar (no path, no trailing slash).
# Sign-in cookies and passkeys are bound to it. Use https in production; http://localhost:3000 is fine for trying it out.
ORIGIN=http://localhost:3000

# Optional. Passkeys are tied to a domain. Defaults to the host name of ORIGIN.
# RP_ID=

# Optional build-time settings (rebuild the image after changing them).
# BASE_PATH=/pb        # mount the app below a path instead of the site root
# APP_NAME=WOD PR Tracker
# PASSKEYS=off         # hide passkey sign-in

# Optional. Time zone of the container.
# TZ=Europe/London
